# ==============================================================================
# V-Sentinel Environment Variables
# V-Sentinel 环境变量
#
# Copy this file to .env and adjust values for your deployment.
# 复制此文件为 .env 并根据部署环境调整。
# ==============================================================================

# ── Backend / 后端 ──────────────────────────────────────────────────────────────

# Backend HTTP server port (default: 8000)
# 后端 HTTP 服务端口
# BACKEND_PORT=8000

# SQLite database path (default: ./v_sentinel.db)
# SQLite 数据库路径
# DB_PATH=./v_sentinel.db

# ── Auth / 认证 ─────────────────────────────────────────────────────────────────

# HMAC secret for signing API tokens. MUST be set in production; if omitted a
# random per-process secret is used and all tokens are invalidated on restart.
# 签名 API token 的 HMAC 密钥。生产环境必须设置；省略时使用进程内随机密钥，
# 服务重启后所有 token 失效。
# V_SENTINEL_AUTH_SECRET=change-me-to-a-random-string

# Default admin password (first user bootstrap).
# 默认管理员密码（首次启动引导）。
# V_SENTINEL_ADMIN_PASSWORD=admin

# Default operator password (legacy env-based auth).
# 默认操作员密码（旧版基于环境变量的认证）。
# V_SENTINEL_OPERATOR_PASSWORD=

# Default viewer password (legacy env-based auth).
# 默认查看者密码（旧版基于环境变量的认证）。
# V_SENTINEL_USER_PASSWORD=

# ── CORS ────────────────────────────────────────────────────────────────────────

# Comma-separated allowed origins (default: *). When restricted origins are set,
# credentials (cookies) are also enabled automatically.
# 逗号分隔的允许来源（默认：*）。设置受限来源时将自动启用凭据（cookie）。
# V_SENTINEL_CORS_ORIGINS=https://your-domain.com,https://admin.your-domain.com

# ── Frontend / 前端 ─────────────────────────────────────────────────────────────

# Frontend dev-server port (default: 3000, dev only)
# 前端开发服务器端口
# VITE_BACKEND_PORT=8000

# Base path for the frontend SPA (default: /). Useful when serving behind a
# sub-path reverse proxy.
# 前端 SPA 基础路径，用于反向代理子路径部署。
# VITE_APP_BASE_PATH=/

# Also read by the backend as fallback:
# 后端也会读取此变量作为回退：
# APP_BASE_PATH=/

# Explicit API base URL (auto-detected from <base> tag in production)
# 显式指定 API 基础 URL（生产环境通常从 <base> 标签自动检测）
# VITE_API_BASE_URL=

# Explicit WebSocket base URL (auto-detected from <base> tag in production)
# 显式指定 WebSocket 基础 URL
# VITE_WS_BASE_URL=

# MediaMTX WebRTC URL for the frontend player (default: http://localhost:8889)
# 前端播放器使用的 MediaMTX WebRTC URL
# VITE_MEDIAMTX_WEBRTC_URL=http://localhost:8889
